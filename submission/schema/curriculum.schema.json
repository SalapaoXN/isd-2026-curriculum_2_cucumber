{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "IT curriculum submission",
    "type": "object",
    "additionalProperties": false,
    "required": [
        "program",
        "plans"
    ],
    "properties": {
        "program": {
            "const": "IT"
        },
        "plans": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "prefixItems": [
                {
                    "allOf": [
                        {
                            "$ref": "#/$defs/plan"
                        },
                        {
                            "properties": {
                                "plan": {
                                    "const": "coop"
                                }
                            }
                        }
                    ]
                },
                {
                    "allOf": [
                        {
                            "$ref": "#/$defs/plan"
                        },
                        {
                            "properties": {
                                "plan": {
                                    "const": "no_coop"
                                }
                            }
                        }
                    ]
                }
            ],
            "items": false
        }
    },
    "$defs": {
        "plan": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "source",
                "description",
                "plan",
                "total_courses",
                "courses"
            ],
            "properties": {
                "source": {
                    "type": "string"
                },
                "description": {
                    "type": "string"
                },
                "plan": {
                    "enum": [
                        "coop",
                        "no_coop"
                    ]
                },
                "total_courses": {
                    "type": "integer",
                    "minimum": 0
                },
                "courses": {
                    "type": "array",
                    "items": {
                        "$ref": "#/$defs/course"
                    }
                }
            }
        },
        "course": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "code",
                "name_th",
                "name_en",
                "credits",
                "category",
                "type",
                "prerequisite",
                "flexible_year_semester",
                "year",
                "semester",
                "source_provenance"
            ],
            "properties": {
                "code": {
                    "type": "string",
                    "minLength": 1
                },
                "name_th": {
                    "type": "string"
                },
                "name_en": {
                    "type": "string"
                },
                "credits": {
                    "type": "string"
                },
                "category": {
                    "type": "string"
                },
                "type": {
                    "type": "string"
                },
                "prerequisite": {
                    "type": "string"
                },
                "flexible_year_semester": {
                    "type": [
                        "string",
                        "null"
                    ]
                },
                "note": {
                    "type": [
                        "string",
                        "null"
                    ]
                },
                "year": {
                    "type": "integer"
                },
                "semester": {
                    "type": "integer"
                },
                "desc_th": {
                    "type": "string"
                },
                "desc_en": {
                    "type": "string"
                },
                "source_provenance": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                        "$ref": "#/$defs/provenance"
                    }
                }
            }
        },
        "provenance": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "program",
                "source_filename",
                "source_page",
                "document_category",
                "document_page"
            ],
            "properties": {
                "program": {
                    "type": "string"
                },
                "source_filename": {
                    "type": "string"
                },
                "source_page": {
                    "type": "integer"
                },
                "document_category": {
                    "enum": [
                        "description",
                        "plan"
                    ]
                },
                "document_page": {
                    "type": [
                        "integer",
                        "null"
                    ]
                }
            }
        }
    }
}
