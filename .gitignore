# Environment / Python
.env
.venv/
__pycache__/
*.py[cod]
.pytest_cache/

# Local tooling
.opencode/
.opencodeignore
opencode.json
project_snapshot.zip

# Generated / large local data (populated by copy or pipeline runs)
data/input/*
data/output/ocr/*
data/output/extracted/*
data/output/consolidated/*
cucumber_outputs/*
*.tmp
*.log
demo.db
/curriculum.db

# Tracked reference artifacts (small, required for RAG + tests)
!data/input/.gitkeep
!data/output/final/
!data/output/final/*.json
!tests/reference/
!cucumber_outputs/runtime/curriculum.db
!reports/evaluation_reference/
